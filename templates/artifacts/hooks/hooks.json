{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "<<TOOL_PATTERN>>",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/<<SCRIPT>>",
            "timeout": 5,
            "statusMessage": "<<WHAT_IT_IS_DOING>>"
          }
        ]
      }
    ]
  }
}
